{
  "name": "story-spec",
  "version": "0.1.0",
  "description": "Storybook stories as OpenSpec scenarios: a scenario() helper that gives a story a Given/When/Then and a sync that writes the spec from the stories.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    "./walkthrough/capture": "./walkthrough/capture.js",
    "./walkthrough/schema.json": "./walkthrough/schema.json",
    "./walkthrough": {
      "types": "./walkthrough/index.d.ts",
      "default": "./walkthrough/index.js"
    },
    "./walkthrough/node": {
      "types": "./walkthrough/node.d.ts",
      "default": "./walkthrough/node.js"
    },
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "bin": {
    "story-spec": "./bin/story-spec.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin",
    "lib",
    "walkthrough",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js && tsc -p test"
  },
  "peerDependencies": {
    "storybook": ">=8.3"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react": "10.6.1",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "typescript": "7.0.2"
  }
}
